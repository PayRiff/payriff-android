  "viewReveal": {
    "description": "CONTRACT §20.3 (revision 11). When the payment view applies a loaded order. Times are in ms. deviceAnswerMs is when the device check (canMakePayments / isReadyToPay) answers, counted from the moment the order arrived: negative = before it, null = never. orderOffered: the order passes §17.3 points 2 and 3; loadFails: the order read failed. expect.appliedAfterMs: when the order is applied (the Pay amount, the error line or view.notPayable, and onOrderLoaded / onLoadFailed), counted from the order's arrival; walletShown: whether the wallet button appears with it; it never appears later for this order. deviceCheckStarted: the device check started when the view appeared, before the order arrived. iOS native answers canMakePayments synchronously, so on iOS every offered case applies at 0.",
    "waitMs": 1000,
    "cases": [
      {
        "name": "the check answered before the order",
        "walletConfigured": true,
        "orderOffered": true,
        "loadFails": false,
        "deviceAnswerMs": -200,
        "deviceAnswer": true,
        "expect": {
          "deviceCheckStarted": true,
          "appliedAfterMs": 0,
          "walletShown": true
        }
      },
      {
        "name": "the check answers 300 ms after the order",
        "walletConfigured": true,
        "orderOffered": true,
        "loadFails": false,
        "deviceAnswerMs": 300,
        "deviceAnswer": true,
        "expect": {
          "deviceCheckStarted": true,
          "appliedAfterMs": 300,
          "walletShown": true
        }
      },
      {
        "name": "the device cannot pay",
        "walletConfigured": true,
        "orderOffered": true,
        "loadFails": false,
        "deviceAnswerMs": 100,
        "deviceAnswer": false,
        "expect": {
          "deviceCheckStarted": true,
          "appliedAfterMs": 100,
          "walletShown": false
        }
      },
      {
        "name": "the check is too slow: no wallet for this order",
        "walletConfigured": true,
        "orderOffered": true,
        "loadFails": false,
        "deviceAnswerMs": 1500,
        "deviceAnswer": true,
        "expect": {
          "deviceCheckStarted": true,
          "appliedAfterMs": 1000,
          "walletShown": false
        }
      },
      {
        "name": "the check never answers",
        "walletConfigured": true,
        "orderOffered": true,
        "loadFails": false,
        "deviceAnswerMs": null,
        "deviceAnswer": null,
        "expect": {
          "deviceCheckStarted": true,
          "appliedAfterMs": 1000,
          "walletShown": false
        }
      },
      {
        "name": "an order the wallet cannot pay is applied at once",
        "walletConfigured": true,
        "orderOffered": false,
        "loadFails": false,
        "deviceAnswerMs": 500,
        "deviceAnswer": true,
        "expect": {
          "deviceCheckStarted": true,
          "appliedAfterMs": 0,
          "walletShown": false
        }
      },
      {
        "name": "a failed order read is applied at once",
        "walletConfigured": true,
        "orderOffered": false,
        "loadFails": true,
        "deviceAnswerMs": 500,
        "deviceAnswer": true,
        "expect": {
          "deviceCheckStarted": true,
          "appliedAfterMs": 0,
          "walletShown": false
        }
      },
      {
        "name": "no wallet configured: no device check",
        "walletConfigured": false,
        "orderOffered": false,
        "loadFails": false,
        "deviceAnswerMs": null,
        "deviceAnswer": null,
        "expect": {
          "deviceCheckStarted": false,
          "appliedAfterMs": 0,
          "walletShown": false
        }
      }
    ]
  }

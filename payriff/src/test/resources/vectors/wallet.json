  "applePaySheet": {
    "description": "How the SDK completes the Apple Pay sheet after didAuthorizePayment (§17.6). budgetSeconds counts from the authorization.",
    "budgetSeconds": 20,
    "cases": [
      {
        "situation": "final success status",
        "outcome": "finalSuccess",
        "sheet": "success",
        "then": "returnResult"
      },
      {
        "situation": "final declined status",
        "outcome": "finalDeclined",
        "sheet": "failure",
        "then": "returnResult"
      },
      {
        "situation": "final CANCELED or EXPIRED status",
        "outcome": "finalCancelled",
        "sheet": "failure",
        "then": "returnResult"
      },
      {
        "situation": "final status outside the groups (e.g. REFUNDED)",
        "outcome": "finalUnexpected",
        "sheet": "failure",
        "then": "returnResult"
      },
      {
        "situation": "failed(...) from /pay or the flow",
        "outcome": "failed",
        "sheet": "failure",
        "then": "returnResult"
      },
      {
        "situation": "device compromised before /pay",
        "outcome": "deviceCompromised",
        "sheet": "failure",
        "then": "returnResult"
      },
      {
        "situation": "nextAction challenge",
        "outcome": "challenge",
        "sheet": "success",
        "then": "continueAfterSheet"
      },
      {
        "situation": "nextAction redirect",
        "outcome": "redirect",
        "sheet": "success",
        "then": "continueAfterSheet"
      },
      {
        "situation": "no final status within budgetSeconds",
        "outcome": "budgetExpired",
        "sheet": "success",
        "then": "continueAfterSheet"
      }
    ]
  },

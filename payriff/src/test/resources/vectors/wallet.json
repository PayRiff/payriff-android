  "platformGuard": {
    "description": "Revision 10: a wallet is offered only on its own platform, whatever is configured. Apple Pay on iOS, Google Pay on Android.",
    "cases": [
      {
        "platform": "ios",
        "applePayConfigured": true,
        "googlePayConfigured": true,
        "expect": {
          "applePay": true,
          "googlePay": false
        }
      },
      {
        "platform": "android",
        "applePayConfigured": true,
        "googlePayConfigured": true,
        "expect": {
          "applePay": false,
          "googlePay": true
        }
      },
      {
        "platform": "ios",
        "applePayConfigured": false,
        "googlePayConfigured": true,
        "expect": {
          "applePay": false,
          "googlePay": false
        }
      },
      {
        "platform": "android",
        "applePayConfigured": true,
        "googlePayConfigured": false,
        "expect": {
          "applePay": false,
          "googlePay": false
        }
      }
    ]
  },
  "googlePayGateway": {
    "description": "Revision 10: the tokenization parameters. gatewayMerchantId: the order's, else the config's; none → Google Pay is not offered. gateway: the order's, else the config's, else \"payriff\". Each value trimmed; blank counts as missing.",

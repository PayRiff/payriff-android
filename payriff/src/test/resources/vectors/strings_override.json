  "resolution": [
    {
      "name": "the view's strings win over the config's",
      "view": {
        "pay": "Ödə"
      },
      "config": {
        "pay": "Pay now"
      },
      "language": "en",
      "field": "pay",
      "expect": "Ödə"
    },
    {
      "name": "a blank value counts as not set",
      "view": {
        "pay": "   "
      },
      "config": {
        "pay": "Pay now"
      },
      "language": "en",
      "field": "pay",
      "expect": "Pay now"
    },
    {
      "name": "nothing set: the built-in text of the language",
      "view": {},
      "config": {},
      "language": "ru",
      "field": "pay",
      "expect": "Оплатить"
    },
    {
      "name": "a field error from the config",
      "view": {},
      "config": {
        "numberInvalid": "Kart numarası geçersiz"
      },
      "language": "az",
      "field": "numberInvalid",
      "expect": "Kart numarası geçersiz"
    },
    {
      "name": "a 3DS sheet text from the config",
      "view": {},
      "config": {
        "closeConfirmContinue": "Ödemeye devam et"
      },
      "language": "en",
      "field": "closeConfirmContinue",
      "expect": "Ödemeye devam et"
    },
    {
      "name": "values are used as given, not trimmed",
      "view": {
        "sheetTitle": " Ödeme "
      },
      "config": {},
      "language": "en",
      "field": "sheetTitle",
      "expect": " Ödeme "
    }
  ],
  "payButton": [
    {
      "name": "payButtonTitle is the whole text",
      "style": {
        "payButtonTitle": "Ödə €12",
        "payButtonLabel": "Buy"
      },
      "strings": {
        "pay": "Öde"
      },
      "amount": 23.45,
      "currency": "AZN",
      "expect": "Ödə €12"
    },
    {
      "name": "payButtonTitle while the amount is unknown",
      "style": {
        "payButtonTitle": "Ödə €12"
      },
      "strings": {},
      "amount": null,
      "currency": null,
      "expect": "Ödə €12"
    },
    {
      "name": "a blank payButtonTitle counts as not set",
      "style": {
        "payButtonTitle": "  "
      },
      "strings": {},
      "language": "en",
      "amount": 10.5,
      "currency": "AZN",
      "expect": "Pay 10.50 AZN"
    },

<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.payriff</groupId>
  <artifactId>payriff-android</artifactId>
  <version>1.0.0-rc.2</version>
  <packaging>aar</packaging>
  <name>Payriff Android SDK</name>
  <description>Pay Payriff orders with a native card form: on-device card encryption, 3-D Secure in a native sheet, only a publishable key in the app. Documentation: https://docs.payriff.com</description>
  <url>https://payriff.com</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
      <name>Payriff SDK License</name>
      <url>https://github.com/PayRiff/payriff-android/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>payriff</id>
      <name>Payriff</name>
      <organization>Payriff</organization>
      <organizationUrl>https://payriff.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/PayRiff/payriff-android.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/PayRiff/payriff-android.git</developerConnection>
    <url>https://github.com/PayRiff/payriff-android</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/PayRiff/payriff-android/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>androidx.activity</groupId>
      <artifactId>activity</artifactId>
      <version>1.9.3</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.0.21</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core-ktx</artifactId>
      <version>1.13.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-android</artifactId>
      <version>1.9.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>

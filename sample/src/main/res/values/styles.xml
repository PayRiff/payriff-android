<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Example.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- A block of monospace text that can be selected: the result's details and JSON. -->
    <style name="Example.Code" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/code</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- The pay buttons: full width and 52 dp tall, like the Flutter example's. -->
    <style name="Example.PayButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- "Pay in bottom sheet": a drag handle above PayriffPaymentView, as tall as its content. The NestedScrollView lets
     the sheet and the form scroll together when the keyboard leaves too little room. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- A fixed id: a result that arrives after the activity was recreated during 3-D Secure goes to the view
             with it. -->
        <com.payriff.android.PayriffPaymentView
            android:id="@+id/paymentView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

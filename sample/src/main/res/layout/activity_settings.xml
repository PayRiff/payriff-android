<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="@android:style/TextAppearance.Material.Title"
            tools:targetApi="28" />

        <TextView
            style="@style/Example.Label"
            android:text="@string/publishable_key" />

        <EditText
            android:id="@+id/publishableKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/publishable_key_hint"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:minHeight="48dp" />

        <TextView
            style="@style/Example.Label"
            android:text="@string/environment" />

        <RadioGroup
            android:id="@+id/environmentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/sandboxButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/sandbox" />

            <RadioButton
                android:id="@+id/productionButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="@string/production" />
        </RadioGroup>

        <TextView
            style="@style/Example.Label"
            android:text="@string/language" />

        <RadioGroup
            android:id="@+id/languageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/languageDevice"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/language_device" />

            <RadioButton
                android:id="@+id/languageAz"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="@string/language_az" />

            <RadioButton
                android:id="@+id/languageEn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="@string/language_en" />

            <RadioButton
                android:id="@+id/languageRu"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="@string/language_ru" />
        </RadioGroup>

        <Switch
            android:id="@+id/loggingSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/enable_logging" />

        <Switch
            android:id="@+id/screenCaptureSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/allow_screen_capture" />

        <!-- The look of PayriffPaymentView; the payment screen reads it when it opens. -->
        <TextView
            style="@style/Example.Label"
            android:layout_marginTop="16dp"
            android:text="@string/payment_view_style" />

        <Switch
            android:id="@+id/customStyleSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/payment_view_custom_style" />

        <Switch
            android:id="@+id/showLabelsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/payment_view_show_labels" />

        <Switch
            android:id="@+id/showBadgesSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/payment_view_show_badges" />

        <Switch
            android:id="@+id/showSecureNoteSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/payment_view_show_secure_note" />

        <Switch
            android:id="@+id/showPoweredBySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/payment_view_show_powered_by" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_view_style_note"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />

        <Button
            android:id="@+id/resetButton"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_note"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>

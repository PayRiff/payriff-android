<?xml version="1.0" encoding="utf-8"?>
<!-- The outcome of a payment: a big icon and title, the amount, the details and the result JSON. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/resultIconFrame"
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ImageView
                android:id="@+id/resultIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:targetApi="28"
            tools:text="@string/result_success" />

        <TextView
            android:id="@+id/resultAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="1.00 AZN" />

        <TextView
            android:id="@+id/resultMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            tools:text="@string/result_success_message" />

        <TextView
            android:id="@+id/resultDetails"
            style="@style/Example.Code"
            android:layout_marginTop="16dp"
            tools:text="Order id: o1" />

        <TextView
            style="@style/Example.Label"
            android:layout_marginTop="12dp"
            android:text="@string/result_json" />

        <TextView
            android:id="@+id/resultJson"
            style="@style/Example.Code"
            android:textSize="11sp"
            tools:text="{}" />
    </LinearLayout>
</ScrollView>

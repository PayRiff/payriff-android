<?xml version="1.0" encoding="utf-8"?>
<!-- "Pay in page": a back button above PayriffPaymentView, which fills the rest. The window behind both has the
     view's background (Theme.PayriffExample.Payment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <!-- A fixed id: a result that arrives after the activity was recreated during 3-D Secure goes to the view with it. -->
    <com.payriff.android.PayriffPaymentView
        android:id="@+id/paymentView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

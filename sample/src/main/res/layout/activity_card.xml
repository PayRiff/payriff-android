<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/card_title"
                android:textAppearance="@android:style/TextAppearance.Material.Title"
                tools:targetApi="28" />

            <Button
                android:id="@+id/settingsButton"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/configSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/missingKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/card_missing_key"
            android:textColor="@color/warning"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The order your backend created (orderId + clientSecret), pasted or typed. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/card_order_section"
                        android:textAppearance="@android:style/TextAppearance.Material.Subhead"
                        android:textStyle="bold"
                        tools:targetApi="28" />

                    <Button
                        android:id="@+id/clearOrderButton"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear"
                        android:visibility="gone" />
                </LinearLayout>

                <EditText
                    android:id="@+id/cardOrderIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/card_order_id"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/cardClientSecretInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/card_client_secret"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/pasteOrderButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/card_paste_order" />

                <!-- Opens PaymentActivity: the SDK's ready-made PayriffPaymentView for this order. -->
                <Button
                    android:id="@+id/paymentViewButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_open_payment_view" />

                <TextView
                    android:id="@+id/pastedOrderInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    tools:text="Merchant · CREATED"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/pasteErrorView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/card_order_tool_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- What the customer pays: the order as Payriff.retrieveOrder returned it. -->
            <TextView
                android:id="@+id/cardAmountHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@android:style/TextAppearance.Material.Headline"
                tools:text="1.00 AZN" />

            <TextView
                android:id="@+id/cardDescriptionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                tools:text="Order #42" />

            <!-- The form's look: Payriff's default (the hosted payment page) or a custom PayriffCardFormStyle. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/card_form_style"
                    android:textColor="@color/text_secondary" />

                <RadioGroup
                    android:id="@+id/formStyleGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkedButton="@+id/formStyleDefault"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/formStyleDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/card_form_style_default" />

                    <RadioButton
                        android:id="@+id/formStyleCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="48dp"
                        android:text="@string/card_form_style_custom" />
                </RadioGroup>
            </LinearLayout>

            <CheckBox
                android:id="@+id/holderToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/card_show_holder" />

            <com.payriff.android.PayriffCardForm
                android:id="@+id/cardForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/payButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="Pay 1.00 AZN" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/card_pay_note"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Example.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/section_log" />

            <Button
                android:id="@+id/clearLogButton"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/logView"
            style="@style/Example.Card"
            android:text="@string/log_empty"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

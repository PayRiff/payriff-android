# Copy to local.properties (git-ignored) and fill in. Never commit real values.
# Android Studio writes sdk.dir itself; alternatively set ANDROID_HOME.
sdk.dir=

# Example app settings. Compiled into the DEBUG build of :sample only; release builds have no publishable key.
# Publishable key (pr_pk_live_...) of the environment below, from the Payriff dashboard.
payriff.publishableKey=
# SANDBOX or PRODUCTION
payriff.environment=SANDBOX
# AZ (api.payriff.com) or SA (Saudi Arabia, GCC Pay, api.gccpay.sa). SA has no sandbox:
# with SA, SANDBOX payments go to production and charge real cards.
payriff.region=AZ
# Google Pay in the payment view: true or false. The Payriff sandbox has no wallets, so Google Pay shows only for
# PRODUCTION orders, and it charges real cards. Google Pay in production needs the app's production access in the
# Google Pay & Wallet Console (integration type Gateway).
payriff.googlePay=false
# Optional: your Google merchant ID from the Google Pay & Wallet Console.
payriff.googlePayMerchantId=
# Payriff's gateway merchant ID for Google Pay. Needed when Payriff's orders have no googlePay object: without it
# from the order or here, Google Pay does not show.
payriff.googlePayGatewayMerchantId=
# There is no secret key here: your server creates the order with its secret key (POST /api/v3/orders)
# and returns orderId and clientSecret.
